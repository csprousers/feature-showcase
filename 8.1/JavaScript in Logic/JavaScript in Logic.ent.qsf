              Select an option to demonstrate interacting with JavaScript from CSPro logic.
              
              <?
              if result <> "" then
              	QSF.write("The result of the last operation:\n\n**_");
              	QSF.writeEncoded("%s", result);
              	QSF.writeLine("_**");
              endif;
              
              if resultImageUrl <> "" then
              	QSF.writeLine("<br><br>![demo image](%s)", resultImageUrl);
              endif;
              ?>
